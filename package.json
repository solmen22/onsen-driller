{
  "name": "onsen-driller",
  "version": "0.0.1",
  "private": true,
  "description": "Onsen Driller (working title) - incremental web game",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --mode web",
    "dev:cg": "vite --mode crazygames",
    "dev:poki": "vite --mode poki",
    "art": "node scripts/build-art.mjs",
    "font": "node scripts/subset-font.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:property:full": "vitest run --config vitest.property.config.ts",
    "sim": "node tools/sim/run.ts",
    "test:balance": "node tools/sim/balance.ts",
    "build:web": "vite build --mode web && node scripts/copy-headers.mjs",
    "build:crazygames": "vite build --mode crazygames",
    "build:itch": "vite build --mode itch",
    "build:poki": "vite build --mode poki",
    "build:all": "npm run build:web && npm run build:crazygames && npm run build:itch && npm run build:poki",
    "build:e2e": "vite build --mode e2e && vite build --mode e2e-crazygames",
    "check:size": "node scripts/check-size.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "test:checks": "node --test scripts/check-selftest.mjs",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/package-verify.mjs",
    "preview:web": "vite preview --outDir dist/web --port 4173 --strictPort",
    "test:e2e": "playwright test --project=chromium --project=prod-builds",
    "test:e2e:nightly": "playwright test --project=webkit --project=firefox --project=mobile-safari --project=mobile-chrome",
    "test:e2e:full": "playwright test --project=chromium-full --project=webkit --project=firefox --project=mobile-safari --project=mobile-chrome --project=prod-builds",
    "preview:lan": "vite preview --outDir dist/web --port 4173 --strictPort --host"
  },
  "dependencies": {
    "break_infinity.js": "2.2.0",
    "lz-string": "1.5.0",
    "phaser": "4.2.1",
    "preact": "10.29.8",
    "valibot": "1.5.0",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
